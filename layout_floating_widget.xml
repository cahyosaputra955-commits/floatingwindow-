<?xml version="1.0" encoding="utf-8"?>
<!-- Tampilan "bubble" kecil yang mengambang di atas aplikasi lain.
     Saat di-tap, bisa diperluas menjadi panel (lihat layout_floating_expanded.xml) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivBubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble_circle"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:contentDescription="@string/app_name" />

</FrameLayout>
